<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:background="?attr/colorSurface">

        <TextView
            android:id="@+id/elapsedTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="90sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="Elapsed"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"/>

        <View
            android:layout_width="150dp"
            android:layout_height="4dp"
            android:background="@color/separatorColor"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"/>

        <LinearLayout
            android:layout_width="277dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/yearsTextView"
                android:layout_width="169dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yearsTextViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:text=" Years"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold"
                android:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="277dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/monthsTextView"
                android:layout_width="159dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/monthsTextViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:text=" Months"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="276dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/daysTextView"
                android:layout_width="167dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/daysTextViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:text=" Days"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="275dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hoursTextView"
                android:layout_width="166dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hoursTextViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:text=" Hours"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="274dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/minutesTextView"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/minutesTextViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:text=" Minutes"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="276dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/secondsTextView"
                android:layout_width="151dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="80sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/secondsTextViewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:text=" Seconds"
                android:textColor="?attr/colorOnSurface"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>